generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum WeightUnit {
  LB
  KG
}

enum EnergyUnit {
  KCAL
  KJ
}

enum NutrientKind {
  ENERGY
  MACRO
  MICRO
}

enum TargetRule {
  MIN
  MAX
  RANGE
}

enum GoalDirection {
  LOSE
  GAIN
  MAINTAIN
}

enum Source {
  USER
  TOKEN
  SEED
}

enum ActorType {
  USER
  TOKEN
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               Role      @default(USER)
  timezone           String    @default("UTC")
  weightUnit         WeightUnit @default(LB)
  energyUnit         EnergyUnit @default(KCAL)
  mustChangePassword Boolean   @default(false)
  theme              String    @default("neutral")
  sessionVersion     Int       @default(0)
  emailVerifiedAt    DateTime?
  disabledAt         DateTime?
  createdAt          DateTime  @default(now())
  firstMcpCallAt        DateTime?
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?

  tokens             ApiToken[]
  nutrients          Nutrient[]
  mealTypes          MealType[]
  targets            Target[]
  weightGoals        WeightGoal[]
  meals              Meal[]
  weights            Weight[]
  entryRevisions     EntryRevision[]
  invitesCreated     Invite[]  @relation("InviteCreator")
  inviteUsed         Invite[]  @relation("InviteUser")
  guidelineRevisions GuidelineRevision[]
  sessions           Session[]
  emailTokens        EmailToken[]
  dayActivities      DayActivity[]
  dayAdjustments     DayAdjustment[]
}

/// One logged activity (a workout, a walk). Many per day. Bumps the day's energy
/// and protein allowance only — never the baseline targets (that is set_targets).
/// The (userId, source, externalId) partial unique index for external imports
/// lives only in the migration SQL (partial indexes are not representable here).
model DayActivity {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  kcal           Int
  proteinG       Int       @default(0)
  label          String?
  minutes        Int?
  source         Source
  tokenId        String?
  externalId     String?
  idempotencyKey String?
  loggedAt       DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
}

/// Recorded roll-up of a day's activities. Derived but stored, so a rendered past
/// day never changes. Recomputed from DayActivity rows in the same transaction as
/// every activity write — never incremented.
model DayAdjustment {
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  activityKcal     Int      @default(0)
  activityProteinG Int      @default(0)
  updatedAt        DateTime @default(now())

  @@id([userId, date])
}

model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  email       String?
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  usedBy      User?     @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model Nutrient {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  displayName String
  unit        String
  kind        NutrientKind
  targetRule  TargetRule
  sortOrder   Int          @default(0)
  archivedAt  DateTime?

  itemNutrients MealItemNutrient[]

  @@unique([userId, code])
}

model MealType {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  displayName String
  sortOrder   Int       @default(0)
  archivedAt  DateTime?

  meals Meal[]

  @@unique([userId, code])
}

model Target {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  values        Json
  source        Source
  tokenId       String?
  createdAt     DateTime  @default(now())

  @@index([userId, effectiveFrom])
}

model WeightGoal {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  targetKg      Decimal
  direction     GoalDirection
  source        Source
  tokenId       String?
  createdAt     DateTime      @default(now())

  @@index([userId, effectiveFrom])
}

model Meal {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  mealTypeId String
  mealType   MealType  @relation(fields: [mealTypeId], references: [id], onDelete: Restrict)
  notes      String?
  loggedAt   DateTime  @default(now())
  source     Source
  tokenId    String?
  deletedAt  DateTime?

  items MealItem[]

  @@unique([userId, date, mealTypeId])
  @@index([userId, date])
}

model MealItem {
  id             String    @id @default(cuid())
  mealId         String
  meal           Meal      @relation(fields: [mealId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  normalizedName String
  quantity       Decimal   @default(1)
  notes          String?
  loggedAt       DateTime  @default(now())
  source         Source
  tokenId        String?
  idempotencyKey String?
  pinned         Boolean   @default(false)
  deletedAt      DateTime?

  nutrients MealItemNutrient[]

  @@unique([mealId, normalizedName])
  @@unique([userId, idempotencyKey])
  @@index([userId])
}

model MealItemNutrient {
  itemId        String
  item          MealItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  nutrientId    String
  nutrient      Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Cascade)
  amountPerUnit Decimal

  @@id([itemId, nutrientId])
}

model Weight {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  valueKg        Decimal
  loggedAt       DateTime @default(now())
  source         Source
  tokenId        String?
  idempotencyKey String?
  pinned         Boolean  @default(false)

  @@unique([userId, date])
  @@unique([userId, idempotencyKey])
  @@index([userId, date])
}

model GuidelineSection {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  revisions GuidelineRevision[]
}

model GuidelineRevision {
  id           String           @id @default(cuid())
  sectionId    String
  section      GuidelineSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  body         String
  links        Json             @default("[]")
  authorUserId String?
  author       User?            @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  tokenId      String?
  createdAt    DateTime         @default(now())

  @@index([sectionId, createdAt])
}

model EntryRevision {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  actorType  ActorType
  actorId    String
  override   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// OAuth 2.1 shim for Claude custom connectors: clients register via DCR, the user
/// pastes an ApiToken on the authorize page, and the token endpoint returns that
/// token as the Bearer credential. Nothing here grants anything an ApiToken couldn't.
model OAuthClient {
  id           String   @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  grants OAuthGrant[]
}

model OAuthCode {
  id                  String      @id @default(cuid())
  codeHash            String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  tokenId             String
  encToken            String
  scope               String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime    @default(now())
}

model OAuthGrant {
  id          String      @id @default(cuid())
  refreshHash String      @unique
  clientId    String
  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenId     String
  encToken    String
  scope       String?
  createdAt   DateTime    @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
}

model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  ip        String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Single-use, expiring tokens for email flows (verification, password reset,
/// email change). Only SHA-256 hashes are stored, mirroring ApiToken/Invite.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  kind      String // VERIFY | RESET | EMAIL_CHANGE
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}
