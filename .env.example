# ---- Nourish environment ----
# Copy to .env and fill in. The app Zod-validates these at boot and refuses to
# start with anything missing.

# Postgres connection for the app container (matches the db service in docker-compose.yml).
DATABASE_URL=postgresql://nourish:${POSTGRES_PASSWORD}@db:5432/nourish

# Password for the db container. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# NextAuth session signing secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# The URL you reach the app at — your Tailscale MagicDNS name or 100.x address.
NEXTAUTH_URL=http://nourish.<tailnet>.ts.net:3000

# First admin, bootstrapped on first start (you'll be forced to change the password
# at first login). The admin manages invites/users/backups and can never hold or
# see nutrition data — invite yourself as a normal user for tracking.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ---- optional ----
# The public MCP base URL agents connect to, when it differs from the app's own
# address — e.g. the Tailscale Funnel origin. The Settings token dialog builds
# connector URLs from this. Include the /api/mcp path, no trailing slash:
# MCP_PUBLIC_URL=https://nourish.<tailnet>.ts.net/api/mcp
MCP_PUBLIC_URL=
# Upstash Redis for distributed rate limiting + login backoff. Leave empty to use
# the built-in in-memory limiter (fine for a single-container home deploy);
# REQUIRED on serverless hosts (the Vercel preflight enforces it).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend for account email (verification, password reset, security notices,
# invite delivery). Leave empty and all email-gated features fall back gracefully:
# signups are auto-verified (invites pin identity), resets go through the admin.
RESEND_API_KEY=
EMAIL_FROM="Nourish <mail@yourdomain.example>"

# PostHog server-side analytics (event names + counts only, never nutrition data).
# Leave empty to disable entirely.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Direct (non-pooled) database URL for migrations on Neon/pgbouncer setups.
# Leave empty when DATABASE_URL is already a direct connection (Docker deploy).
MIGRATE_DATABASE_URL=
